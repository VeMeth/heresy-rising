# Copy to .env and set real values before going public.
# This file is safe to commit; .env is gitignored and must never be committed.

# Strong admin password for the /admin control panel.
# REQUIRED in production: if unset or left as the shipped default, admin
# endpoints are automatically disabled (fail-closed) and the server logs a
# security warning. Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=change-me-to-a-long-random-secret

# Port the game API/WebSocket server listens on (inside the container).
SERVER_PORT=4100

# Bind the server port only to loopback on the host so it is not directly
# exposed to the internet. The public-facing nginx client container proxies to it.
SERVER_HOST_BIND=127.0.0.1

# Public-facing client port (the nginx container maps this to 80 internally).
CLIENT_PORT=8281

# Comma-separated list of browser origins allowed to use the API/sockets.
# List every public URL the site will be served from. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8281

# The server always runs behind the nginx reverse proxy in this stack, so we
# trust X-Forwarded-* headers. This makes rate limiting and per-clientLimits
# key on the real client IP instead of the proxy's IP. Keep this true.
TRUST_PROXY=true

# ── Heresy Bots (AI operatives) ───────────────────────────────────────────
# Three separate secrets (per the locked v1.1.0 bot spec):
#   BOT_API_KEY        — manager ↔ engine HTTP auth (reserve/despawn seats).
#   ADMIN_API_KEY      — gate the admin panel path (proxied from heresy-server).
#   SIM_BYPASS_TOKEN   — direct path for the sim/test harness.
# All three are REQUIRED in production. Generate strong random values for each:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_API_KEY=change-me-to-a-long-random-secret
ADMIN_API_KEY=change-me-to-a-long-random-secret
SIM_BYPASS_TOKEN=change-me-to-a-long-random-secret

# ── Heresy Sim (game-balance simulator) ───────────────────────────────────
# heresy-server proxies two sim callers to the heresy-sim container (:7879):
#   1. game:simulate socket event — a game host previewing their own lobby's
#      proposed roster before sealing it. Host-gated, lobby-phase-only,
#      capped, and cooldown-limited per lobby (see below).
#   2. POST /api/admin/simulate — a site admin running arbitrary/larger
#      batches. Admin-password-gated, higher cap, no lobby tie-in.
# heresy-server presents SIM_BYPASS_TOKEN (above) to heresy-sim on both
# hops; the browser never sees it, exactly like ADMIN_API_KEY above.
HERESY_SIM_URL=http://heresy-sim:7879
SIM_MAX_GAMES_HOST=100          # host preview cap, clamped silently (not rejected)
SIM_MAX_GAMES_ADMIN=500         # admin batch cap, clamped silently (not rejected)
SIM_HOST_COOLDOWN_MS=60000      # per-lobby cooldown between a host's game:simulate calls
SIM_FETCH_TIMEOUT_MS=30000      # outbound timeout for the heresy-server -> heresy-sim hop

# heresy-sim container's own tunables (defense in depth — heresy-server also
# caps on its side above, but heresy-sim never trusts that blindly).
SIM_HARD_MAX_GAMES=1000
SIM_MAX_WORKERS=2               # keep in sync with heresy-sim's cpu limit in docker-compose*.yml

# heresy-sim also publishes its own port directly (docker-compose*.yml) so a
# trusted local caller — e.g. a bot/script running outside the compose stack
# — can hit POST /simulate directly instead of going through heresy-server's
# host/admin caps and cooldown (see heresy-sim/README.md, "Direct HTTP
# access"). Same SIM_BYPASS_TOKEN as above is required either way; the direct
# path has no additional rate limiting beyond SIM_HARD_MAX_GAMES.
# SIM_PORT is also the in-container port (set above). Defaults to loopback —
# if your caller runs on the SAME machine as docker, 127.0.0.1 already works
# with zero changes. Only widen this if the caller is elsewhere on your LAN,
# and never to 0.0.0.0 on a host with any port forwarded to the internet.
SIM_HOST_BIND=127.0.0.1

# Generic OpenAI-compatible LLM runtime (LM Studio / vLLM / llama.cpp server /
# OpenAI itself). Required before any bot will actually act — without a base
# URL, bots spawn and join but pass every turn (silent observers, PASSIVE
# mode).
#
# LM Studio: load Qwen3-14B (Q4_K_M GGUF), context length 8192, GPU offload
# full, and enable "Serve on Local Network" — it must bind 0.0.0.0, not
# 127.0.0.1, or the bot-manager container cannot reach it. From inside the
# container the host is reachable at host.docker.internal (docker-compose.yml
# already sets extra_hosts for this on Linux).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3-14b

# ── MiniMax cloud profiles (optional backend) ──────────────────────────────
# The local profile (LM Studio via OPENAI_* above) is the default and requires
# no additional config. MiniMax-M2.7 and MiniMax-M3 are optional cloud backends.
# For cloud profiles to be spawnable, set MINIMAX_API_KEY; without it they
# report unavailable (not silent PASSIVE bots). Pricing variables should be
# confirmed against your MiniMax billing dashboard, as published rates vary.
BOT_DEFAULT_PROFILE=local             # local | minimax-m2.7 | minimax-m3
MINIMAX_API_KEY=                      # unset = MiniMax profiles unavailable
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL_M27=MiniMax-M2.7         # override e.g. MiniMax-M2.7-highspeed
MINIMAX_MODEL_M3=MiniMax-M3
MINIMAX_USD_PER_MTOK_IN=0.30          # confirm against your billing dashboard
MINIMAX_USD_PER_MTOK_OUT=1.20         # confirm against your billing dashboard
BOT_CLOUD_CONCURRENCY=3               # parallel cloud LLM calls per queue lane
#MAX_CLOUD_BOTS_PER_GAME=4            # cloud bots per conclave; defaults to MAX_BOTS_PER_GAME
#
# USD spend limits — OPT-IN, both OFF by default. This deployment runs on a
# MiniMax token plan, where per-token rates aren't what's billed, so a dollar
# ceiling would only act as a silent kill switch that stops a bot mid-game
# over a cost nobody is charged for. Set either to a number to re-arm the
# guard (do this if you move to pay-per-token billing). Spend is still
# METERED regardless and shown in the admin panel — it's a useful proxy for
# how fast a plan's token quota is burning.
#BOT_DAILY_USD_CAP=5.00               # process-wide rolling 24h spend cap
#BOT_COST_CEILING_USD=0.50            # per bot per game (cloud profiles only)

# Manager-side tunables. Defaults match the spec; override per deployment.
MAX_BOT_SESSIONS=12            # global cap (one per seat at max player count)
MAX_BOTS_PER_GAME=4            # hard cap per Conclave
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.7
MAX_TOKENS=350
MAX_TOKENS_PER_GAME=200000     # now counts input tokens too; local inference is free
LLM_NO_THINK=true              # append /no_think + hard <think> stripping (Qwen3)
LLM_STRUCTURED_OUTPUT=true     # response_format:json_schema; auto-falls back on unsupported servers
BOT_ACTION_DELAY_MS=5000       # fixed pacing delay after an engine prompt

# ConversationDirector — central, heuristic (no-LLM) turn-taking for public
# day chat. Replaces the old per-bot reactive chat debounce.
DIRECTOR_TICK_MS=4000
BOT_MIN_CHAT_GAP_MS=25000      # minimum time between two chat turns from the same bot
BOT_CHAT_PER_PHASE_MAX=3       # hard per-bot cap on chat messages per phase
BOT_INTRO_GAP_MS=12000         # stagger between Day-1 bot introductions
BOT_REACTIVE_THRESHOLD=1.0     # min weighted score (raw score * talkativeness) before a bot reactively speaks
BOT_FACTION_CHAT=false         # heretic-only private faction chat block in prompts
# ── Additional tunables (read by code, all optional with safe defaults) ───
# These were previously undocumented. Values shown are the built-in defaults;
# uncomment only to override.

# heresy-server
#PORT=4100                      # legacy fallback for SERVER_PORT (SERVER_PORT wins)
#RATE_LIMIT_WINDOW_MS=60000     # HTTP rate-limit window
#RATE_LIMIT_MAX=120             # max requests per window per client IP
#GAME_CONFIG_DIR=./game_data    # override the balance-config directory
#GAME_DB_PATH=                  # override the sqlite file path
#BOT_MANAGER_URL=http://heresy-bot-manager:7878   # engine -> bot-manager

# bot-manager
#HERESY_BOT_PORT=7878           # port the bot-manager itself listens on
#HERESY_GAME_HOST=http://127.0.0.1:4100           # bot-manager -> engine
#TOP_P=0.9                      # LLM nucleus sampling (sibling of LLM_TEMPERATURE)
#MAX_RETRIES=2                  # LLM call retry attempts

# heresy-client (dev only)
#SERVER_URL=http://localhost:4100                 # vite dev-server proxy target
